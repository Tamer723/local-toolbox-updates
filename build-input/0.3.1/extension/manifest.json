{
  "manifest_version": 3,
  "name": "Local Toolbox",
  "version": "0.3.1",
  "description": "Personal local media toolbox with one-click verified self-updates, validated media links, safe site-scoped Chrome session bridge, parallel downloads, local MP3 conversion, live speed/ETA, queue and history.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "sidePanel",
    "tabs",
    "storage",
    "contextMenus",
    "clipboardWrite",
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Local Toolbox",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
