{
  "manifest_version": 3,
  "name": "Local Toolbox",
  "version": "0.5.0",
  "description": "Local media toolbox with smart browser media detection, network/DOM stream discovery, direct local downloads, yt-dlp/FFmpeg processing, persistent jobs, speed/ETA and history.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "sidePanel",
    "tabs",
    "storage",
    "contextMenus",
    "clipboardWrite",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Local Toolbox",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.instagram.com/*",
        "*://instagram.com/*",
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://facebook.com/*",
        "*://*.facebook.com/*",
        "*://fb.watch/*"
      ],
      "js": [
        "page-preview.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "contracts.js",
        "media-detection.js",
        "media-detector.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
